# =============================================================================
# Arcittance — Arc Testnet (.env)
# Copy this file to .env and fill in the values below.
# NEVER commit .env — it is gitignored.
# =============================================================================

# ─── Network (required — do not change) ─────────────────────────────────────
ARC_NETWORK=arc:testnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_WS_URL=wss://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002

# ─── Tokens (fixed Arc testnet addresses — no need to change) ───────────────
USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000
EURC_CONTRACT_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# ─── Testnet personas (7 separate private keys — with or without 0x prefix) ──
# Generate 7 wallets, fund via https://faucet.circle.com (Arc Testnet → USDC)
# Required funded roles for smoke: deployer, keeper, facilitator
DEPLOYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
# Path B bank-mock: Arc USDC EOA that tops up Mint via Payins (required; no fallback)
TREASURY_PRIVATE_KEY=
FACILITATOR_PRIVATE_KEY=
EMPLOYER_DEMO_PRIVATE_KEY=
REMIT_SENDER_DEMO_PRIVATE_KEY=
RECIPIENT_DEMO_PRIVATE_KEY=

# ─── Circle Developer APIs (from https://console.circle.com) ───────────────
CIRCLE_API_KEY=
CIRCLE_WALLETS_ENTITY_SECRET=
CIRCLE_GATEWAY_API_KEY=
# JSON string — must include arcDomain: 26
CIRCLE_CCTP_BRIDGEKIT_CONFIG={"arcDomain":26}
# StableFX / Mint sandbox (Phase 10) — TEST key uses api-sandbox.circle.com
CIRCLE_STABLEFX_API_KEY=
# Optional alias for the same sandbox key (Payins / Custody / Payouts)
CIRCLE_MINT_API_KEY=
STABLEFX_API_BASE_URL=https://api-sandbox.circle.com

CIRCLE_WALLETS_APP_ID=
CIRCLE_FACILITATOR_WALLET_ID=
CIRCLE_COMPLIANCE_BLOCKLIST=0x000000000000000000000000000000000000dEaD

# ─── Frontend (also set in frontend/.env.local) ─────────────────────────────
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_USE_CIRCLE_KEEPER=false

# ─── Supabase (Phase 5+ — leave empty for now) ─────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Contract addresses (populated after: npm run deploy:arc) ───────────────
NEXT_PUBLIC_PAYROLL_ORG_REGISTRY_ADDRESS=
NEXT_PUBLIC_CONDITIONAL_ESCROW_ADDRESS=
NEXT_PUBLIC_SUBSCRIPTION_MANAGER_ADDRESS=
NEXT_PUBLIC_REMITTANCE_VAULT_ADDRESS=

REPORT_GAS=false
